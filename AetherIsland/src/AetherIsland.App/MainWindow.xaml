<Window x:Class="AetherIsland.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aether Island" Width="560" Height="118" MinWidth="560" MaxWidth="560"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
 Background="Transparent" ShowInTaskbar="True" Topmost="True" WindowStartupLocation="Manual">
 <Window.Resources>
  <Style x:Key="PillButton" TargetType="Button">
   <Setter Property="Foreground" Value="#FFF7F5FF"/>
   <Setter Property="Background" Value="#24FFFFFF"/>
   <Setter Property="BorderBrush" Value="#48A99BFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="frame" CornerRadius="12" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
       Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="frame" Property="Background" Value="#58796BFF"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Surface" Margin="8" CornerRadius="30" Background="#F010152A"
  BorderBrush="#778D8BFF" BorderThickness="1"
  PreviewMouseLeftButtonDown="Surface_Drag">
  <Border.Effect><DropShadowEffect Color="#080516" BlurRadius="28" ShadowDepth="7" Opacity=".6"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="18,0,14,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/>
     <ColumnDefinition Width="42"/><ColumnDefinition Width="42"/>
    </Grid.ColumnDefinitions>
    <Viewbox Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
     <Grid Width="64" Height="64">
      <Ellipse Fill="#302A3F82"/><Ellipse Margin="4" Stroke="#A99BFF" StrokeThickness="2"/>
      <Path Data="M8,35 L18,25 L25,13 L34,26 L41,21 L55,35 L51,44 L15,44 Z" Fill="#39CDAA"/>
      <Path Data="M18,25 L25,13 L34,26 L41,21 L46,28 L36,34 L25,34 Z" Fill="#A69BFF"/>
      <Path Data="M25,13 L30,27 L25,30 L21,25 Z" Fill="#F5F1FF"/>
      <Ellipse Width="50" Height="20" Stroke="#5BE6FF" StrokeThickness="3">
       <Ellipse.RenderTransform><RotateTransform Angle="-22"/></Ellipse.RenderTransform>
      </Ellipse>
      <Path Data="M48,7 L50,13 L56,15 L50,17 L48,23 L46,17 L40,15 L46,13 Z" Fill="#F4E8FF"/>
     </Grid>
    </Viewbox>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
     <TextBlock Text="AETHER ISLAND" Foreground="#FFF8F7FF" FontSize="15" FontWeight="Bold"/>
     <TextBlock Text="YOUR DESKTOP, IN ORBIT" Foreground="#FFB9B8D3" FontSize="9" Margin="0,5,0,0"/>
     <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <Ellipse Width="6" Height="6" Fill="#FF68E8F5" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" Text="READY" Foreground="#FF94E9F0" FontSize="9" FontWeight="Bold" Margin="7,0,0,0"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
     <TextBlock x:Name="ClockText" Text="--:--" Foreground="#FFF8F7FF" FontSize="25" HorizontalAlignment="Right"/>
     <TextBlock x:Name="DateText" Text="LOADING" Foreground="#FFB9B8D3" FontSize="9" HorizontalAlignment="Right"/>
    </StackPanel>
    <Button Grid.Column="3" Style="{StaticResource PillButton}" Content="⌄" Width="34" Height="34" Click="Toggle_Click"/>
    <Button Grid.Column="4" Style="{StaticResource PillButton}" Content="×" Width="34" Height="34" Click="Close_Click"/>
   </Grid>
   <Border x:Name="Details" Grid.Row="1" Margin="14,0,14,14" Padding="8" CornerRadius="20"
    Background="#1CFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Visibility="Collapsed">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Margin="4" Padding="12" CornerRadius="15" Background="#241D2342">
      <StackPanel>
       <TextBlock Text="FOCUS SESSION" Foreground="#FFBDB7F1" FontSize="9" FontWeight="Bold"/>
       <TextBlock x:Name="Countdown" Text="25:00" Foreground="White" FontSize="25" Margin="0,5,0,7"/>
       <Button x:Name="FocusButton" Style="{StaticResource PillButton}" Content="Start 25 min" Click="Focus_Click"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="1" Margin="4" Padding="12" CornerRadius="15" Background="#241D2342">
      <StackPanel>
       <TextBlock Text="QUICK LAUNCH" Foreground="#FF9DEAF0" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
       <Button Style="{StaticResource PillButton}" Content="Open Downloads" Click="Downloads_Click"/>
       <Button Style="{StaticResource PillButton}" Content="Open Notepad" Click="Notepad_Click"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="2" Margin="4" Padding="12" CornerRadius="15" Background="#241D2342">
      <StackPanel>
       <TextBlock Text="AETHER STATUS" Foreground="#FFBDB7F1" FontSize="9" FontWeight="Bold"/>
       <TextBlock Text="Your space is ready." Foreground="White" FontSize="13" Margin="0,8,0,4"/>
       <TextBlock Text="Media, notifications and shortcuts are planned for upcoming milestones."
        Foreground="#FFB9B8D3" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <Button Style="{StaticResource PillButton}" Content="Settings location" Click="Settings_Click"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
